# Neon / PostgreSQL connection string
DATABASE_URL="postgresql://username:password@ep-your-unit.region.aws.neon.tech/neondb?sslmode=require"

# NASA API key (optional for low-volume development; recommended for production)
NASA_API_KEY=""

# AI Advisor (Google Gemini / AI SDK)
GOOGLE_GENERATIVE_AI_API_KEY=""

# NVIDIA NIM / Vision models (optional crop-health inspection)
NVIDIA_API_KEY=""
NVIDIA_CHAT_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"
NVIDIA_VISION_MODEL="nvidia/nemotron-3.5-super-vl-120b-a12b"

# Mapbox / Map service token
MAPBOX_API_KEY=""

# Optional: NASA Earthdata token for the GPM IMERG rainfall cross-check
EARTHDATA_TOKEN=""
